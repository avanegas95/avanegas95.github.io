---
import BlobAgent from "@/components/blob/BlobAgent.astro";
import SocialLinks from "@/components/ui/SocialLinks.astro";
import { DotPattern } from "@/components/ui/dot-pattern";
import { socialLinks } from "@/data/social-links";
---

<section
  class="relative flex min-h-[90vh] items-center overflow-hidden lg:min-h-[80vh]"
  id="home"
>
  <DotPattern
    client:idle
    width={22}
    height={22}
    cr={1}
    className="opacity-70"
  />
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-transparent via-[var(--background)]/40 to-[var(--background)]"
    aria-hidden="true"
  ></div>
  <div class="relative z-10 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 md:py-12 lg:py-16">
    <div class="home-grid">
      <div class="home-intro space-y-4 md:space-y-6">
        <p class="text-[var(--sec)] font-mono mb-2 md:mb-3 text-base animate-fade-in">
          Hi, my name is
        </p>
        <h1 class="text-[var(--white)] text-5xl sm:text-6xl md:text-7xl font-bold mb-2 md:mb-3 animate-fade-in">
          Anderson Vanegas.
        </h1>
        <h2 class="text-[var(--white-icon)] text-3xl sm:text-4xl md:text-5xl font-bold mb-3 md:mb-4 animate-fade-in">
          I help put quality into software.
        </h2>
        <p class="text-[var(--white-icon)] max-w-2xl text-base md:text-lg mb-6 md:mb-8 leading-relaxed animate-fade-in">
          Staff SQA Engineer with 7 years of testing and 3
          years of automation experience. At Boston Dynamics, I build
          Python tooling, Appium mobile tests, and nightly HIL CI pipelines that keep
          robots and software reliable.
        </p>
      </div>

      <div class="home-blob">
        <BlobAgent />
      </div>

      <div class="home-actions space-y-6 md:space-y-8">
        <div class="animate-fade-in flex flex-row gap-4 [animation-delay:0.5s]">
          <a
            href="#projects"
            class="text-center py-3 px-8 border border-[var(--sec)] text-[var(--sec)] rounded-lg hover:bg-[var(--white-icon-tr)] transition-all duration-300 text-base hover:scale-105"
          >
            Check out my work
          </a>
        </div>

        <SocialLinks links={socialLinks} entranceBaseDelay={0.62} />
      </div>
    </div>
  </div>
</section>

<style>
  section {
    counter-reset: section;
  }

  /* One column on mobile (intro, Blob, actions). From lg: intro and actions on the left,
     Blob on the right. Everything is top-aligned and the second row takes the slack, so the
     bubble growing downward never moves the left column. */
  .home-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    align-items: start;
  }
  .home-intro > :last-child {
    margin-bottom: 0;
  }
  @media (min-width: 1024px) {
    .home-grid {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
      grid-template-rows: auto 1fr;
      column-gap: 3rem;
      row-gap: 1.5rem;
    }
    .home-intro {
      grid-column: 1;
      grid-row: 1;
    }
    .home-actions {
      grid-column: 1;
      grid-row: 2;
    }
    .home-blob {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }

  #home .space-y-4 > .animate-fade-in:nth-child(1) {
    animation-delay: 0.1s;
  }
  #home .space-y-4 > .animate-fade-in:nth-child(2) {
    animation-delay: 0.2s;
  }
  #home .space-y-4 > .animate-fade-in:nth-child(3) {
    animation-delay: 0.3s;
  }
  #home .space-y-4 > .animate-fade-in:nth-child(4) {
    animation-delay: 0.4s;
  }
</style>
