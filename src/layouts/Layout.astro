---
import "@/styles/global.css";
import { getEntry } from "astro:content";
import {
  currentRoleFromSummary,
  personJsonLd,
  serializeJsonLd,
} from "@/lib/seo";
import { getContact } from "@/lib/site-content";

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogType?: "website" | "article";
  ogImage?: string;
}

const DEFAULT_OG_IMAGE = "https://avanegas.com/images/og.image.png";
// Real pixel size of public/images/og.image.png.
const OG_IMAGE_WIDTH = 1200;
const OG_IMAGE_HEIGHT = 630;
const SITE_NAME = "Anderson Vanegas";

const {
  title,
  description,
  canonicalUrl,
  ogType = "website",
  ogImage,
} = Astro.props;
const site = Astro.site ?? new URL("https://avanegas.com");
const bio = await getEntry("knowledge", "bio");
const contact = await getContact();
const metaDescription = description ?? bio?.data.summary ?? "";
const resolvedCanonical =
  canonicalUrl ?? new URL(Astro.url.pathname, site).href;
const socialImage = ogImage ?? DEFAULT_OG_IMAGE;

// Person JSON-LD renders on the home page only, built from KB facts.
const role = currentRoleFromSummary(bio?.data.summary ?? "");
const linkedIn = contact?.links.linkedin;
const gitHub = contact?.links.github;
const email = contact?.links.email;
const personLd =
  Astro.url.pathname === "/" && role && email
    ? serializeJsonLd(
        personJsonLd({
          name: SITE_NAME,
          jobTitle: role.title,
          worksFor: role.employer,
          url: new URL("/", site).href,
          email,
          sameAs: [linkedIn, gitHub].filter((v): v is string => !!v),
        }),
      )
    : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={metaDescription} />
    <link rel="canonical" href={resolvedCanonical} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content={String(OG_IMAGE_WIDTH)} />
    <meta property="og:image:height" content={String(OG_IMAGE_HEIGHT)} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={resolvedCanonical} />
    <meta property="og:type" content={ogType} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={socialImage} />

    {personLd && (
      <script type="application/ld+json" is:inline set:html={personLd} />
    )}

    <script is:inline>
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
        document.documentElement.classList.add("has-fade-in");
      }
    </script>
    <script is:inline type="speculationrules">
      {
        "prerender": [
          {
            "where": {
              "or": [
                { "href_matches": "/blog" },
                { "href_matches": "/blog/" },
                {
                  "and": [
                    { "href_matches": "/blog/*" },
                    { "not": { "href_matches": "/blog/tags/*" } }
                  ]
                }
              ]
            },
            "eagerness": "moderate"
          }
        ]
      }
    </script>
  </head>
  <body class="bg-[var(--background)] px-4 sm:px-6 md:px-8 lg:px-12 xl:px-24 pb-20 md:pb-0">
    <a href="#main-content" class="skip-link">
      Skip to main content
    </a>
    <slot />
  </body>
</html>

<script>
  import { initFadeInObserver } from "@/lib/fade-in";

  initFadeInObserver();
</script>
