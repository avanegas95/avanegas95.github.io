---
import { Image } from "astro:assets";
import bdLogo from "@/assets/images/bdlogo.png";
import bdHqBg from "@/assets/images/bd-hq.png";
import sharkNinjaLogo from "@/assets/images/sharkninja-logo.svg";
import sharkNinjaHqBg from "@/assets/images/sharkninja-hq.jpg";
---

<section class="py-8 bg-[#0a192f]" id="experiences">
  <div class="container mx-auto px-4">
    <h2
      class="text-3xl sm:text-4xl md:text-5xl font-medium text-[var(--white)] mb-4 md:mb-6 fade-in fade-in--slow"
    >
      Experiences
    </h2>

    <div
      class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 auto-rows-fr"
    >
      <!-- Boston Dynamics — Staff SQA Engineer (current) -->
      <article
        class="rounded-xl overflow-hidden h-full flex flex-col fade-in fade-in--slow experience-card"
      >
        <div class="experience-card__media">
          <Image
            src={bdHqBg}
            alt="Boston Dynamics headquarters exterior with company signage, Waltham, Massachusetts"
            class="experience-card__photo experience-card__photo--bd"
          />
        </div>
        <div class="experience-card__panel">
          <div class="experience-card__logo-wrap">
            <Image
              src={bdLogo}
              alt="Boston Dynamics Logo"
              class="experience-card__logo"
            />
          </div>
          <div class="experience-card__content">
            <p class="experience-card__company">Boston Dynamics</p>
            <h3 class="experience-card__role">Staff SQA Engineer</h3>
            <p class="experience-card__dates">2026 – Present</p>
            <ul class="experience-card__highlights">
              {/* TODO: Fill in Staff SQA Engineer bullets */}
            </ul>
          </div>
        </div>
      </article>

      <!-- Boston Dynamics — Senior SQA Engineer -->
      <article
        class="rounded-xl overflow-hidden h-full flex flex-col fade-in fade-in--slow experience-card"
      >
        <div class="experience-card__media">
          <Image
            src={bdHqBg}
            alt="Boston Dynamics headquarters exterior with company signage, Waltham, Massachusetts"
            class="experience-card__photo experience-card__photo--bd"
          />
        </div>
        <div class="experience-card__panel">
          <div class="experience-card__logo-wrap">
            <Image
              src={bdLogo}
              alt="Boston Dynamics Logo"
              class="experience-card__logo"
            />
          </div>
          <div class="experience-card__content">
            <p class="experience-card__company">Boston Dynamics</p>
            <h3 class="experience-card__role">Senior SQA Engineer</h3>
            <p class="experience-card__dates">September 2023 – 2026</p>
            <ul class="experience-card__highlights">
              <li class="experience-card__item">
                <span class="experience-card__bullet" aria-hidden="true">▹</span>
                <span>Project QA lead across HIL, Gazebo simulation, and Appium Android app testing.</span>
              </li>
              <li class="experience-card__item">
                <span class="experience-card__bullet" aria-hidden="true">▹</span>
                <span>Built a Python SSH-based monitoring tool for real-time robot metrics.</span>
              </li>
              <li class="experience-card__item">
                <span class="experience-card__bullet" aria-hidden="true">▹</span>
                <span>Integrated automated tests into CI/CD with stage-based reporting.</span>
              </li>
              <li class="experience-card__item">
                <span class="experience-card__bullet" aria-hidden="true">▹</span>
                <span>Onboarded non-SQA engineers through structured QA training.</span>
              </li>
            </ul>
          </div>
        </div>
      </article>

      <!-- SharkNinja Card -->
      <article
        class="rounded-xl overflow-hidden h-full flex flex-col fade-in fade-in--slow experience-card"
      >
        <div class="experience-card__media">
          <Image
            src={sharkNinjaHqBg}
            alt="SharkNinja global headquarters exterior with SharkNinja signage, Needham, Massachusetts"
            class="experience-card__photo experience-card__photo--sn"
          />
        </div>
        <div class="experience-card__panel">
          <div class="experience-card__logo-wrap">
            <Image
              src={sharkNinjaLogo}
              alt="SharkNinja Logo"
              class="experience-card__logo experience-card__logo--sn"
            />
          </div>
          <div class="experience-card__content">
            <p class="experience-card__company">SharkNinja</p>
            <h3 class="experience-card__role">SQA Engineer I/II</h3>
            <p class="experience-card__dates">November 2019 – September 2023</p>
            <ul class="experience-card__highlights">
              <li class="experience-card__item">
                <span class="experience-card__bullet" aria-hidden="true">▹</span>
                <span>Designed and executed manual test cases for cloud services and consumer mobile apps.</span>
              </li>
              <li class="experience-card__item">
                <span class="experience-card__bullet" aria-hidden="true">▹</span>
                <span>Mentored junior engineers and contractors across sprints.</span>
              </li>
              <li class="experience-card__item">
                <span class="experience-card__bullet" aria-hidden="true">▹</span>
                <span>Ran daily standups, defect triage, and release coordination.</span>
              </li>
              <li class="experience-card__item">
                <span class="experience-card__bullet" aria-hidden="true">▹</span>
                <span>Helped the automation team debug and improve Python scripts.</span>
              </li>
            </ul>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  /* Fluid type steps follow tasteskill base.css; sizes track card width via cqw. */
  .experience-card {
    container-type: inline-size;
    container-name: experience-card;
    transform: translateY(0);
    transition: transform 0.3s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .experience-card:hover {
      transform: translateY(-4px);
    }

    .experience-card:hover .experience-card__photo {
      transform: scale(1.04);
    }
  }

  .experience-card__media {
    position: relative;
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 768px) {
    .experience-card__media {
      aspect-ratio: 2 / 1;
    }
  }

  @media (min-width: 1024px) {
    .experience-card__media {
      aspect-ratio: 5 / 2;
    }
  }

  .experience-card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.45s ease-out;
  }

  .experience-card__photo--bd {
    object-position: 50% 22%;
  }

  .experience-card__photo--sn {
    object-position: 50% 38%;
  }

  @media (max-width: 767px) {
    .experience-card__photo--sn {
      object-position: 50% 42%;
    }
  }

  .experience-card__panel {
    position: relative;
    flex: 1;
    padding: clamp(1.25rem, 4cqw, 1.5rem);
    text-align: center;
    background: #112240;
  }

  .experience-card__logo-wrap {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, -50%);
  }

  .experience-card__logo {
    width: clamp(4.5rem, 22cqw, 6rem);
    height: clamp(4.5rem, 22cqw, 6rem);
    border-radius: 9999px;
    border: 4px solid #112240;
  }

  .experience-card__logo--sn {
    background: white;
    object-fit: contain;
    padding: 0.75rem;
  }

  .experience-card__content {
    margin-top: clamp(2.25rem, 10cqw, 3rem);
  }

  .experience-card__company {
    margin: 0 0 clamp(1.25rem, 5cqw, 2rem);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(1rem, 0.88rem + 1.1cqw, 1.125rem);
    line-height: 1.35;
    color: #64ffda;
  }

  .experience-card__role {
    margin: 0 0 0.5rem;
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(1.0625rem, 0.9rem + 1.35cqw, 1.3125rem);
    font-weight: 600;
    line-height: 1.3;
    color: #fff;
    text-wrap: balance;
  }

  .experience-card__dates {
    margin: 0 0 clamp(1rem, 3.5cqw, 1.5rem);
    font-size: clamp(0.8125rem, 0.76rem + 0.55cqw, 0.9375rem);
    line-height: 1.45;
    color: #9ca3af;
  }

  .experience-card__highlights {
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
    max-width: none;
    text-align: left;
  }

  .experience-card__item {
    display: flex;
    gap: 0.5rem;
    font-size: clamp(0.875rem, 0.8rem + 0.75cqw, 1.0625rem);
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: #d1d5db;
    text-wrap: pretty;
  }

  .experience-card__item + .experience-card__item {
    margin-top: 0.5rem;
  }

  .experience-card__bullet {
    flex-shrink: 0;
    margin-top: 0.2em;
    color: #64ffda;
  }
</style>
