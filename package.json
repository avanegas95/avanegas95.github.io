{
  "name": "portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/check-node.mjs",
    "prebuild": "node scripts/check-node.mjs",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && astro check",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun",
    "og:render": "node scripts/og/render.ts",
    "favicon:render": "node scripts/favicon/render.ts",
    "guard:pii": "node scripts/pii-guard.ts",
    "voice:check": "node scripts/voice-lock.ts check",
    "voice:accept": "node scripts/voice-lock.ts accept",
    "voice:init": "node scripts/voice-lock.ts init",
    "facts:check": "node scripts/facts-check.ts",
    "check:copy": "npm run voice:check && (npm run facts:check || true) && npm run build && npm run guard:pii && PW_PORT=4399 playwright test tests/e2e/hero-about.spec.ts tests/e2e/experience.spec.ts tests/e2e/smoke.spec.ts tests/e2e/a11y-home.spec.ts tests/e2e/legacy-routes.spec.ts tests/e2e/resume-pdf.spec.ts --project=chromium",
    "check:bundle": "node scripts/check-client-bundle.ts",
    "eval": "node evals/run.ts",
    "eval:dry": "node evals/run.ts --dry-run"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@fontsource/fira-code": "^5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "5.0.4",
    "astro": "^7.3.8",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^16.0.0",
    "happy-dom": "21.0.1",
    "pdfjs-dist": "^6.4.299",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "serve": "14.2.6",
    "shadcn": "^4.21.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "5.0.4"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.133.0",
    "@astrojs/react": "^7.0.1",
    "@astrojs/vercel": "11.0.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "@vercel/functions": "3.10.3",
    "botid": "1.5.11",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "yaml": "2.9.1"
  },
  "overrides": {
    "playwright-core": "1.64.0",
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  }
}
