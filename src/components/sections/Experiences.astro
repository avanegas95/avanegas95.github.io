---
import { Image } from "astro:assets";
import bdLogo from "@/assets/images/bdlogo.png";
import bdHqBg from "@/assets/images/bd-hq.png";
import sharkNinjaLogo from "@/assets/images/sharkninja-logo.svg";
import sharkNinjaHqBg from "@/assets/images/sharkninja-hq.jpg";
import { getRoles } from "@/lib/site-content";

// Facts (titles, dates, bullets) come from the KB; this map holds images only (CLAUDE.md rule 1).
// Keyed by the company slug so no employer name is hard-coded here.
const media = {
  bostondynamics: {
    logo: bdLogo,
    photo: bdHqBg,
    photoAlt:
      "headquarters exterior with company signage, Waltham, Massachusetts",
    photoClass: "experience-card__photo--bd",
    logoClass: "",
  },
  sharkninja: {
    logo: sharkNinjaLogo,
    photo: sharkNinjaHqBg,
    photoAlt:
      "global headquarters exterior with company signage, Needham, Massachusetts",
    photoClass: "experience-card__photo--sn",
    logoClass: "experience-card__logo--sn",
  },
} as const;
type MediaKey = keyof typeof media;
const slug = (company: string) => company.toLowerCase().replace(/[^a-z]/g, "");

const MONTHS = [
  "January",
  "February",
  "March",
  "April",
  "May",
  "June",
  "July",
  "August",
  "September",
  "October",
  "November",
  "December",
];
const monthYear = (ym: string) => {
  const [y, m] = ym.split("-");
  return `${MONTHS[Number(m) - 1]} ${y}`;
};

const roles = await getRoles();
---

<section class="py-8 bg-[var(--background)]" id="experience">
  <!-- Alias so existing #experiences links keep working (nav switches in P5.5-08b). -->
  <span id="experiences" aria-hidden="true"></span>
  <div class="container mx-auto px-4">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium text-[var(--white)] mb-4 md:mb-6 fade-in fade-in--slow">
      Experience
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {roles.map((r) => {
        // A role with no bullets (the intern stint) renders as a compact title-and-dates card.
        // Site cards use the shorter siteBullets when present, else the full resume bullets.
        const bullets = r.siteBullets ?? r.bullets;
        const compact = bullets.length === 0;
        const m = compact ? undefined : media[slug(r.company) as MediaKey];
        return (
          <div
            class="experience-card fade-in fade-in--slow relative h-full overflow-hidden rounded-xl border border-white/[0.08] bg-[var(--surface-card)]"
            data-testid="experience-card"
          >
            <article class="flex h-full flex-col overflow-hidden rounded-[inherit]">
              {m && (
                <div class="experience-card__media">
                  <Image
                    src={m.photo}
                    alt={`${r.company} ${m.photoAlt}`}
                    widths={[320, 480, 640, 768, 960]}
                    sizes="(min-width: 1024px) 33vw, (min-width: 768px) 50vw, 100vw"
                    class:list={["experience-card__photo", m.photoClass]}
                  />
                </div>
              )}
              <div class="experience-card__panel">
                {m && (
                  <div class="experience-card__logo-wrap">
                    <Image
                      src={m.logo}
                      alt={`${r.company} logo`}
                      width={96}
                      height={96}
                      densities={[1, 2]}
                      class:list={["experience-card__logo", m.logoClass]}
                    />
                  </div>
                )}
                <div
                  class:list={[
                    "experience-card__content",
                    compact && "experience-card__content--compact",
                  ]}
                >
                  <p class="experience-card__company">{r.company}</p>
                  <h3 class="experience-card__role">{r.title}</h3>
                  <p class="experience-card__dates">
                    {monthYear(r.start)} –{" "}
                    {r.end ? monthYear(r.end) : "Present"}
                  </p>
                  {bullets.length > 0 && (
                    <ul class="experience-card__highlights">
                      {bullets.map((b) => (
                        <li class="experience-card__item">
                          <span
                            class="experience-card__bullet"
                            aria-hidden="true"
                          >
                            ▹
                          </span>
                          <span>{b}</span>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>
            </article>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  #experiences {
    display: block;
    scroll-margin-top: var(--nav-height);
  }

  /* Fluid type steps follow tasteskill base.css; sizes track card width via cqw. */
  .experience-card {
    container-type: inline-size;
    container-name: experience-card;
  }

  @media (hover: hover) and (pointer: fine) {
    .experience-card__photo {
      opacity: 0.85;
    }

    .experience-card:hover .experience-card__photo {
      opacity: 1;
      transform: scale(1.04);
    }
  }

  .experience-card__media {
    position: relative;
    width: 100%;
    flex-shrink: 0;
    overflow: hidden;
    aspect-ratio: 16 / 9;
  }

  @media (min-width: 768px) {
    .experience-card__media {
      aspect-ratio: 2 / 1;
    }
  }

  @media (min-width: 1024px) {
    .experience-card__media {
      aspect-ratio: 5 / 2;
    }
  }

  .experience-card__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 0.45s ease-out,
      transform 0.45s ease-out;
  }

  .experience-card__photo--bd {
    object-position: 50% 22%;
  }

  .experience-card__photo--sn {
    object-position: 50% 38%;
  }

  @media (max-width: 767px) {
    .experience-card__photo--sn {
      object-position: 50% 42%;
    }
  }

  .experience-card__panel {
    position: relative;
    flex: 1;
    padding: clamp(1.25rem, 4cqw, 1.5rem);
    text-align: center;
    background: var(--surface-card);
  }

  .experience-card__logo-wrap {
    position: absolute;
    left: 50%;
    top: 0;
    transform: translate(-50%, -50%);
  }

  .experience-card__logo {
    width: clamp(4.5rem, 22cqw, 6rem);
    height: clamp(4.5rem, 22cqw, 6rem);
    border-radius: 9999px;
    border: 4px solid var(--surface-card);
  }

  .experience-card__logo--sn {
    background: white;
    object-fit: contain;
    padding: 0.75rem;
  }

  .experience-card__content {
    margin-top: clamp(2.25rem, 10cqw, 3rem);
  }

  .experience-card__content--compact {
    margin-top: 0;
  }

  .experience-card__company {
    margin: 0 0 clamp(1.25rem, 5cqw, 2rem);
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(1rem, 0.88rem + 1.1cqw, 1.125rem);
    line-height: 1.35;
    color: var(--sec);
  }

  .experience-card__role {
    margin: 0 0 0.5rem;
    font-family:
      ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: clamp(1.0625rem, 0.9rem + 1.35cqw, 1.3125rem);
    font-weight: 600;
    line-height: 1.3;
    color: var(--text-strong);
    text-wrap: balance;
  }

  .experience-card__dates {
    margin: 0 0 clamp(1rem, 3.5cqw, 1.5rem);
    font-size: clamp(0.8125rem, 0.76rem + 0.55cqw, 0.9375rem);
    line-height: 1.45;
    color: var(--text-muted);
  }

  .experience-card__highlights {
    margin: 0;
    padding: 0;
    list-style: none;
    width: 100%;
    max-width: none;
    text-align: left;
  }

  .experience-card__item {
    display: flex;
    gap: 0.5rem;
    font-size: clamp(0.875rem, 0.8rem + 0.75cqw, 1.0625rem);
    line-height: 1.55;
    letter-spacing: 0.01em;
    color: var(--text-body);
    text-wrap: pretty;
  }

  .experience-card__item + .experience-card__item {
    margin-top: 0.5rem;
  }

  .experience-card__bullet {
    flex-shrink: 0;
    margin-top: 0.2em;
    color: var(--sec);
  }
</style>
