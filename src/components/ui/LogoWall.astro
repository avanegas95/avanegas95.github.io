---
import { technologies, techDisplayNames, techUrls } from "@/data/technologies";

const logoItems = technologies.map((tech) => ({
  tech,
  href: techUrls[tech],
  label: techDisplayNames[tech],
}));

const groups = [false, true];
---

<div class="relative mt-6 overflow-x-hidden py-4 max-w-6xl mx-auto">
  <div
    class="pointer-events-none absolute inset-y-0 left-0 z-20 w-12 bg-gradient-to-r from-[var(--background)] to-transparent sm:w-20 md:w-32"
  >
  </div>
  <div
    class="pointer-events-none absolute inset-y-0 right-0 z-20 w-12 bg-gradient-to-l from-[var(--background)] to-transparent sm:w-20 md:w-32"
  >
  </div>

  <div class="logo-wall-track flex" style={`--logo-count: ${logoItems.length}`}>
    {
      groups.map((isDuplicate) => (
        <div class="logo-wall-group flex shrink-0 items-center" aria-hidden={isDuplicate ? "true" : undefined}>
          {logoItems.map(({ tech, href, label }) => (
            <a
              href={href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={label}
              tabindex={isDuplicate ? -1 : undefined}
              class="logo-wall-item group flex shrink-0 items-center gap-2 transition-all duration-300 hover:scale-110"
            >
              <img
                src={`/svg/${tech}.svg`}
                alt=""
                class="h-7 w-auto object-contain opacity-60 transition-all duration-300 group-hover:scale-110 group-hover:opacity-100"
                width="30"
                height="30"
              />
              <span class="text-lg font-medium whitespace-nowrap text-[var(--white-icon)] transition-colors duration-300 group-hover:text-[var(--white)]">
                {label}
              </span>
            </a>
          ))}
        </div>
      ))
    }
  </div>
</div>

<style is:global>
  /* Each group must move by its own width plus one gap for the loop to be seamless. */
  @keyframes logo-wall-scroll {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(-100% - var(--logo-gap)));
    }
  }

  /* Seconds per logo, so scroll speed stays constant as logos are added. */
  .logo-wall-track {
    --logo-gap: 3rem;
    --seconds-per-logo: 3.4s;
    gap: var(--logo-gap);
  }

  .logo-wall-group {
    gap: var(--logo-gap);
    animation: logo-wall-scroll calc(var(--logo-count) * var(--seconds-per-logo)) linear infinite;
    will-change: transform;
  }

  .logo-wall-track:hover .logo-wall-group {
    animation-play-state: paused;
  }

  @media (min-width: 768px) {
    .logo-wall-track {
      --logo-gap: 5rem;
    }
  }

  @media (hover: none) and (pointer: coarse) {
    .logo-wall-track {
      --seconds-per-logo: 5s;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo-wall-group {
      animation: none;
      width: 100%;
      flex-shrink: 1;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
    }

    .logo-wall-group[aria-hidden="true"] {
      display: none;
    }
  }

  .logo-wall-item {
    backface-visibility: hidden;
  }
</style>
