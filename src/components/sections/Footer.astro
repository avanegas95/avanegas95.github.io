---
import SocialLinks from "@/components/ui/SocialLinks.astro";
import { footerTech } from "@/data/footer-tech";
import { footerLinks } from "@/data/footer-links";
import { footerSocialLinks } from "@/data/social-links";
---

<footer
  class="w-full pb-8 md:pb-12 relative overflow-hidden"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="pt-8 md:pt-12 border-t border-[#ffffff10] grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 lg:gap-10">
      <div class="flex flex-col items-center lg:items-start space-y-6 fade-in">
        <SocialLinks links={footerSocialLinks} layout="footer" />
      </div>

      <div
        class="flex flex-col items-center md:items-start space-y-4 md:space-y-6 fade-in"
        style="animation-delay: 0.1s"
      >
        <div class="grid grid-cols-1 gap-2 md:gap-3 w-full max-w-xs">
          {
            footerTech.map((tech) => (
              <div class="flex items-center space-x-2 md:space-x-3 group">
                <span class="text-[var(--white-icon)] text-xs md:text-sm">
                  {tech.desc}
                </span>
                <img
                  src={tech.icon}
                  alt={tech.alt}
                  class="h-4 w-4 md:h-5 md:w-5 object-contain filter brightness-0 invert opacity-50 transition-all duration-300 group-hover:opacity-100 group-hover:scale-110"
                  loading="lazy"
                />
                <span class="text-[var(--white-icon)] text-xs md:text-sm">
                  {tech.name}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="flex flex-col items-center lg:items-start space-y-4 md:space-y-6 fade-in"
        style="animation-delay: 0.2s"
      >
        <nav aria-label="Site links" class="w-full max-w-xs">
          <ul class="grid grid-cols-1 gap-2 md:gap-3 list-none p-0 m-0">
            {
              footerLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="text-[var(--white-icon)] text-xs md:text-sm hover:text-[var(--sec)] transition-all duration-300 rounded-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sec)]"
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <div
      class="mt-8 md:mt-12 pt-6 md:pt-8 border-t border-[#ffffff10] fade-in"
      style="animation-delay: 0.3s"
    >
      <p
        class="text-center text-xs md:text-sm text-[var(--white-icon)] space-y-1 md:space-y-2"
      >
        <span class="block sm:inline">
          Copyright © {new Date().getFullYear()} <a
            href="https://github.com/avanegas95"
            class="hover:text-[var(--sec)] transition-all duration-300"
            >Anderson Vanegas</a
          >. All rights reserved.
        </span>
      </p>
    </div>
  </div>
</footer>
