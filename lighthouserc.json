{
  "ci": {
    "collect": {
      "startServerCommand": "npx serve .vercel/output/static -l 4322 --no-clipboard",
      "startServerReadyPattern": "Accepting connections",
      "url": [
        "http://localhost:4322/",
        "http://localhost:4322/orbithop/",
        "http://localhost:4322/privacy/",
        "http://localhost:4322/blog/",
        "http://localhost:4322/projects/paychira/",
        "http://localhost:4322/projects/orbit-hop/"
      ],
      "numberOfRuns": 3,
      "settings": {
        "chromeFlags": "--headless=new --no-sandbox --disable-dev-shm-usage"
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./reports/lhci"
    }
  }
}
