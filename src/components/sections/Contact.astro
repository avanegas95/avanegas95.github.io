---
import { SectionEyebrow } from "@/components/ui/section-eyebrow";
import { getContact } from "@/lib/site-content";

const contact = await getContact();
---

<section id="contact" class="w-full relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="py-8 md:py-12 border-t border-[#ffffff10] space-y-8 md:space-y-12">
      <div class="space-y-4">
        <SectionEyebrow client:visible className="mb-2 fade-in">
          Let's talk
        </SectionEyebrow>
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-medium text-[var(--white)] mb-4 md:mb-6 fade-in">
          Contact
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8">
        <div class="text-[var(--white-icon)] text-sm md:text-base space-y-4 fade-in">
          <p>
            Have any questions or want to know more about me? Feel free to reach
            out.
          </p>
          {contact && (
            <ul class="space-y-2" id="contact-direct">
              <li>
                <span>Email: </span>
                <a
                  href={`mailto:${contact.links.email}`}
                  class="text-[var(--white)] underline underline-offset-4 hover:text-[var(--sec)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sec)] rounded-sm"
                >
                  {contact.links.email}
                </a>
              </li>
              <li>
                <span>LinkedIn: </span>
                <a
                  href={contact.links.linkedin}
                  rel="noopener noreferrer"
                  class="text-[var(--white)] underline underline-offset-4 hover:text-[var(--sec)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--sec)] rounded-sm"
                >
                  {contact.links.linkedin.replace(/^https?:\/\/(www\.)?/, "")}
                </a>
              </li>
              {contact.location && (
                <li id="contact-location">
                  <span>Location: </span>
                  <span class="text-[var(--white)]">{contact.location}</span>
                </li>
              )}
            </ul>
          )}
        </div>

        <div class="fade-in">
          <form
            id="contact-form"
            action="https://formspree.io/f/mnnpzgay"
            method="POST"
            class="flex flex-col gap-3 md:gap-4"
          >
            <div class="relative">
              <label
                for="contact-from_name"
                class="block mb-1 text-sm md:text-base text-[var(--white)]"
              >
                Name
              </label>
              <input
                id="contact-from_name"
                type="text"
                name="from_name"
                placeholder="Your name"
                required
                class="w-full px-3 md:px-4 py-2 bg-[#1414149c] text-[var(--white)] text-sm md:text-base border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-all duration-300"
              />
              <div class="absolute inset-0 rounded-lg pointer-events-none transition-all duration-300 focus-within:ring-2 focus-within:ring-[var(--sec)]"></div>
            </div>

            <div class="relative">
              <label
                for="contact-reply_to"
                class="block mb-1 text-sm md:text-base text-[var(--white)]"
              >
                Email
              </label>
              <input
                id="contact-reply_to"
                type="email"
                name="reply_to"
                placeholder="Your email address"
                required
                class="w-full px-3 md:px-4 py-2 bg-[#1414149c] text-[var(--white)] text-sm md:text-base border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] transition-all duration-300"
              />
              <div class="absolute inset-0 rounded-lg pointer-events-none transition-all duration-300 focus-within:ring-2 focus-within:ring-[var(--sec)]"></div>
            </div>

            <div class="relative">
              <label
                for="contact-message"
                class="block mb-1 text-sm md:text-base text-[var(--white)]"
              >
                Message
              </label>
              <textarea
                id="contact-message"
                name="message"
                placeholder="Your message"
                rows="6"
                required
                class="w-full px-3 md:px-4 py-2 bg-[#1414149c] text-[var(--white)] text-sm md:text-base border border-[var(--white-icon-tr)] rounded-lg focus:outline-none focus:ring-2 focus:ring-[var(--sec)] resize-none transition-all duration-300"
              ></textarea>
              <div class="absolute inset-0 rounded-lg pointer-events-none transition-all duration-300 focus-within:ring-2 focus-within:ring-[var(--sec)]"></div>
            </div>

            <button
              type="submit"
              class="px-4 py-2 bg-[var(--sec)] text-[var(--background)] font-medium text-sm md:text-base rounded-lg transition-all duration-300 border border-[var(--sec)] hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--white)] disabled:opacity-70 disabled:cursor-wait w-full sm:w-auto"
            >
              Send
            </button>
          </form>

          <div
            id="form-message"
            class="hidden mt-4 text-[var(--white)] text-base md:text-lg fade-in"
            role="status"
          >
            ✅ Thank you for your message!
          </div>
          <p
            id="form-error"
            class="hidden mt-4 text-sm text-red-400 fade-in"
            role="alert"
          >
            There was a problem sending your message. Please try again.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById(
    "contact-form",
  ) as HTMLFormElement | null;
  const formMessage = document.getElementById("form-message");
  const formError = document.getElementById("form-error");

  if (form && formMessage && formError) {
    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const submitButton = form.querySelector(
        'button[type="submit"]',
      ) as HTMLButtonElement | null;

      if (!submitButton) return;

      formError.classList.add("hidden");
      formMessage.classList.add("hidden");

      try {
        submitButton.disabled = true;
        submitButton.textContent = "Sending...";

        const response = await fetch(form.action, {
          method: "POST",
          body: formData,
          headers: { Accept: "application/json" },
        });

        if (response.ok) {
          form.reset();
          form.style.display = "none";
          formMessage.classList.remove("hidden");
        } else {
          formError.classList.remove("hidden");
        }
      } catch {
        formError.classList.remove("hidden");
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = "Send";
      }
    });
  }
</script>

<style>
  input:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-color: var(--sec);
    box-shadow: 0 0 0 2px rgba(var(--sec), 0.2);
  }

  @media (pointer: coarse) {
    input:focus,
    textarea:focus {
      outline: none;
      border-color: var(--sec);
      box-shadow: 0 0 0 2px rgba(var(--sec), 0.2);
    }
  }
</style>
